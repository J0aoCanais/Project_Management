# --- Flask ---
FLASK_ENV=development
FLASK_APP=app.py
SECRET_KEY=change-me

# --- Postgres admin (used by docker-compose only) ---
POSTGRES_ADMIN_PASSWORD=change-me
APP_OWNER_PASSWORD=change-me
APP_USER_PASSWORD=change-me

# --- Database: what the running app uses (restricted role) ---
DATABASE_URL=postgresql+psycopg://app_user:${APP_USER_PASSWORD}@127.0.0.1:5432/propdb

# --- Database: used only when running migrations (owner role) ---
MIGRATION_DATABASE_URL=postgresql+psycopg://app_owner:${APP_OWNER_PASSWORD}@127.0.0.1:5432/propdb